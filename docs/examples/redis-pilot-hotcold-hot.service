[Unit]
Description=Redis Pilot dedicated hot/cold development Redis container
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/podman start --attach redis-pilot-hotcold-hot
ExecStop=/usr/bin/podman stop --time 10 redis-pilot-hotcold-hot
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
