[Unit]
Description=Redis Pilot hot/cold development gateway
Wants=redis-pilot-hotcold-hot.service redis-pilot-hotcold-syncer.service
After=network.target redis-pilot-hotcold-hot.service redis-pilot-hotcold-syncer.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=redis-gateway
Group=redis-gateway
WorkingDirectory=/opt/redis-pilot-hotcold
ExecStartPre=/opt/redis-pilot-hotcold/redis-gateway -config /etc/redis-pilot-hotcold/gateway.yaml -check-config
ExecStart=/opt/redis-pilot-hotcold/redis-gateway -config /etc/redis-pilot-hotcold/gateway.yaml
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
StateDirectory=redis-pilot-hotcold-gateway
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
