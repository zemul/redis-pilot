# redis-proxy 配置文件示例
#
# 用法：redis-proxy -config proxy.yaml
# 配置优先级：CLI flag > YAML > 代码默认值
# 所有字段都是可选的，省略的字段使用代码默认值。

# ─── Discovery 模式（与 static 模式二选一） ───
# 从 Server 拉取快照，动态驱动 listener 和连接池。
# server_endpoint: "http://127.0.0.1:8080"
# server_token: ""      # 与 server.yaml 的 internal_token 保持一致，Proxy 拉快照时携带
# poll_interval: 2s
# poll_timeout: 5s
# poll_wait: 20s

# ─── Static 模式（与 discovery 模式二选一） ───
# 直接配置单个 group 的后端地址。
listen: ":16379"
master: "127.0.0.1:6379"
replicas:
  - "127.0.0.1:6380"
  # - "127.0.0.1:6381"
password: ""  # 空 = 不鉴权

# ─── 通用参数 ───
master_read_weight: 0       # master 读权重（0 = master 不参与读分流）
consistency_window: 500ms   # 会话一致性窗口
pool_size: 64                # 每后端 SHARED 连接池上限（§13）
idle_timeout: 5m             # 空闲连接回收超时（§13）
metrics_listen: ":19100"    # Prometheus /metrics 地址（空 = 关闭）
max_request_bytes: 16777216 # 单条命令最大字节数（D13，默认 16MB）

# ─── 日志 ───
log:
  dir: /data/logs/redis-pilot-proxy    # 为空则不写文件，仅输出到 stdout
  stdout: true
  retention_days: 30                   # 日志保留天数，0 = 不清理

# ─── 伪 Sentinel 服务发现（可选，proxy-design §19） ───
# 让 sentinel 模式客户端零改代码接入：客户端把 sentinel 地址列表指向本端口，
# masterName 用 group 名；get-master-addr-by-name 返回该 group 的 Proxy 数据端口。
# sentinel_listen: ":26379"       # 空 = 关闭
# sentinel_announce_ip: ""        # 返回给客户端的 host；空 = 用连接命中的本地 IP（跨 NAT 必配）
# sentinel_password: ""           # 发现端口鉴权密码；空 = 不鉴权
